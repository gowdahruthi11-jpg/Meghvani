# Meghvani Environment Variables
# Local SQLite for Phase 1; PostgreSQL / PostGIS ready for production
DATABASE_URL=sqlite:///./meghvani.db

# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security (Phase 1 local salt/secret)
SECRET_KEY=meghvani-prototype-secret-salt-2026

# Real SMS & Twilio Gateway Configuration
SMS_PROVIDER=MOCK
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
SMS_WEBHOOK_VALIDATION=true
TWILIO_TRIAL_MODE=false
TWILIO_TRIAL_TEMPLATE_NAME=sms_2fa

# Future Real Voice & WhatsApp Providers
# VOICE_PROVIDER=mock # Options: mock, exotel
# WHATSAPP_PROVIDER=mock # Options: mock, meta_whatsapp_cloud

# Sarvam AI Voice Alert System (Bulbul v3 Text-to-Speech)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
